# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
# .env 는 .gitignore 에 반드시 포함되어야 하며, 절대 커밋하지 마세요.

# --- Binance API: tools/ccxt_binance_toolkit.py 등 파이썬 스크립트에서 직접 사용 ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Freqtrade(docker-compose) 설정 오버라이드: config_binance.json의 빈 값 대신 사용됨 ---
# 주의: docker-compose의 env_file은 값을 그대로 문자열로 읽어들이므로,
#       위 BINANCE_API_KEY와 동일한 값을 아래에도 직접 채워주세요 (변수 참조 불가).
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- 텔레그램 알림 (선택) ---
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- Freqtrade REST API 서버 (선택, 기본 비활성화) ---
# api_server.enabled=false 상태라 실제로 노출되진 않지만, 켤 경우
# config json의 기본 placeholder 대신 아래 값으로 반드시 교체하세요.
# 생성: python -c "import secrets; print(secrets.token_hex(24))"
FREQTRADE__API_SERVER__ENABLED=false
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=

# --- FinRL / TradingAgents 등 experimental 트랙에서만 필요 (해당 스크립트 실행 시에만 채움) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
