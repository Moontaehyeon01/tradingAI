{
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    # *** 이 값을 화면 표시 목적으로 낮추지 말 것 ***
    # 한 번 0.01 로 낮춘 적이 있다 - 화면상 잔고는 줄었지만, freqtrade가
    # profit_all_percent/max_drawdown 을 계산할 때도 이 ratio 로 줄어든
    # 시작자본을 분모로 쓰는 바람에 실제 손실(-8.99 USDT)이 -409% 라는
    # 말도 안 되는 수치로 나왔다. 이 값은 freqtrade 내부 계산 전반에 쓰이므로
    # "화면에 잔고를 0으로 보이게 하고 싶다"는 요구는 dashboard/server.py의
    # fetch_bot_summary(state=="stopped" 면 balance_total 을 0으로 오버라이드)
    # 에서 표시 레이어로만 처리한다. 여기 값은 항상 정상적인 사이징 값(신규
    # 진입 시 실제로 쓰고 싶은 비율)으로 유지할 것.
    "tradable_balance_ratio": 0.5,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": false,
    "dry_run_wallet": 1000,
    "db_url": "sqlite:///user_data/boxbreakout_v2_live.sqlite",
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "leverage": 3,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "options": {
                "defaultType": "future"
            }
        },
        "ccxt_async_config": {
            "options": {
                "defaultType": "future"
            }
        },
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT"
        ],
        "pair_blacklist": [
            "(BUSD|USDC|FDUSD|TUSD)/.*",
            ".*(UP|DOWN|BEAR|BULL)/.*"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": "",
        "notification_settings": {
            "entry": "off",
            "entry_fill": "off",
            "entry_cancel": "off",
            "exit": "off",
            "exit_fill": "off",
            "exit_cancel": "off",
            "status": "off",
            "warning": "off",
            "startup": "off"
        }
    },
    "webhook": {
        "enabled": true,
        "url": "http://host.docker.internal:5000/webhook?secret=REPLACE_WITH_WEBHOOK_SECRET",
        "format": "json",
        "entry_fill": {
            "event": "entry_fill",
            "bot_name": "박스돌파V2",
            "pair": "{pair}",
            "direction": "{direction}"
        },
        "exit_fill": {
            "event": "exit_fill",
            "bot_name": "박스돌파V2",
            "pair": "{pair}",
            "direction": "{direction}",
            "profit_ratio": "{profit_ratio}",
            "profit_amount": "{profit_amount}",
            "stake_currency": "{stake_currency}",
            "exit_reason": "{exit_reason}"
        },
        "status": {
            "event": "status",
            "bot_name": "박스돌파V2",
            "status": "{status}"
        },
        "warning": {
            "event": "warning",
            "bot_name": "박스돌파V2",
            "status": "{status}"
        },
        "startup": {
            "event": "startup",
            "bot_name": "박스돌파V2",
            "status": "{status}"
        }
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8086,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": ""
    },
    "bot_name": "binance-boxbreakout-v2-bot",
    "initial_state": "stopped",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}